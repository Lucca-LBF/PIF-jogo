{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Compilar jogo (projeto inteiro)",
            "command": "gcc",
            "args": [
                "-Wall",
                "-Wextra",
                "-std=c11",
                "-g",
                "-o",
                "${workspaceFolder}/jogo.exe",
                "${workspaceFolder}/Main.c",
                "${workspaceFolder}/notas.c",
                "${workspaceFolder}/ritmo.c",
                "${workspaceFolder}/sistema.c"
            ],
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
